# Copy this file to .env for local development and fill in your real values.
# Never commit the real .env file — .gitignore already excludes it.
# In production (Render), set these in Dashboard → your service → Environment instead.
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
ADMIN_PASSWORD=choose-a-strong-password-for-the-admin-panel

# Optional but recommended: a free MongoDB Atlas cluster so admin edits
# (resume PDF, experience data) survive Render redeploys. Without this,
# the server falls back to local files, which reset on every redeploy.
# See MONGODB_SETUP.md for the 5-minute setup walkthrough.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# MONGODB_DB=portfolio
